# ── WireGuard Web Panel configuration ──
# Copy this file to ".env" and fill in your values.

# Port the web panel listens on (pick any free port, e.g. 8080)
PORT=8080
# Bind address — 0.0.0.0 makes it reachable via the server's public IP
HOST=0.0.0.0
# Public URL, only used in the startup log (e.g. http://YOUR_IP:8080)
PUBLIC_URL=http://YOUR_IP:8080

# URL of your FiveM server's HTTP endpoint for the WireGuard resource.
# When the panel runs on the SAME machine as FiveM, use localhost.
# Used for LIVE data (online players, feed) and live actions (kick/heal/...).
FIVEM_API_URL=http://127.0.0.1:30120/wireguard

# MUST match wireguard_api_token in the FiveM server's server.cfg
API_TOKEN=CHANGE_ME_generate_a_long_random_token

# ── MySQL database (same DB as the FiveM resource / oxmysql) ──
# When set, the panel reads bans, detection history, admins, logs &
# analytics DIRECTLY from MySQL — so it works even if the FiveM server
# is offline. Leave DB_HOST empty to disable DB mode (API-only).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fivem

# Login for the web panel itself
PANEL_USER=admin
PANEL_PASSWORD=CHANGE_ME_set_a_strong_password

# Secret used to sign session cookies (set to a long random string)
SESSION_SECRET=CHANGE_ME_generate_a_long_random_string
